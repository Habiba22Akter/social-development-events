# The Next.js app proxies /api/auth/* and /api/events/* to the Express API
# server and validates session cookies against it in src/proxy.js. Start it
# with `npm start` inside social-development-events-server.
# MongoDB, BetterAuth, the social provider credentials and the event data live
# in that server's .env - this app only needs to know where to forward requests.
AUTH_SERVER_URL=http://localhost:8000

# Optional override used by Server Components that read events directly from
# the Express API. Falls back to AUTH_SERVER_URL when unset.
# EVENT_SERVER_URL=http://localhost:8000

# Public URL of this app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
