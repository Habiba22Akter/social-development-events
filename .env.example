# The Next.js app proxies /api/auth/* to the Express auth server.
# Start it with `npm start` inside social-development-events-server.
AUTH_SERVER_URL=http://localhost:8000

# MongoDB connection string (Atlas or a local mongod).
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/utsho
MONGODB_URI=mongodb://127.0.0.1:27017/utsho

# Optional: database name. Defaults to the name in the connection string.
MONGODB_DB=utsho

# Public URL of the app. Must match the domain users visit (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Long random string used to sign sessions. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Social login is configured on the auth server (.env there). Keep these
# placeholders in sync if you also call the API from this app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional public alias for the app URL, used by the auth config fallback.
NEXT_PUBLIC_APP_URL=http://localhost:3000
