# The Next.js app proxies /api/auth/* to the Express auth server.
# Start it with `npm start` inside social-development-events-server.
# MongoDB, BetterAuth and the social provider credentials live in that
# server's .env - this app only needs to know where to forward requests.
AUTH_SERVER_URL=http://localhost:8000

# Public URL of this app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
